---
// Starlight's hero, with the trust triangle beside the text when the page
// gives its words (`trust` in the frontmatter, src/content.config.ts): the
// title, tagline and buttons on the left, the drawing on the right, on one
// line from 50rem up; on a phone the drawing goes under them. Any other hero
// is Starlight's own.
import Default from '@astrojs/starlight/components/Hero.astro';
import { LinkButton } from '@astrojs/starlight/components';
import TrustTriangle from './docs/TrustTriangle.astro';

const { data } = Astro.locals.starlightRoute.entry;
const { title = data.title, tagline, actions = [] } = data.hero || {};
const trust = data.trust;
---

{
	trust ? (
		<div class="hero">
			<div class="stack">
				<div class="copy">
					{/* Starlight's page title id, for its skip link. */}
					<h1 id="_top" data-page-title set:html={title} />
					{tagline && <div class="tagline" set:html={tagline} />}
				</div>
				{actions.length > 0 && (
					<div class="actions">
						{actions.map(({ attrs: { class: className, ...attrs } = {}, icon, link: href, text, variant }) => (
							<LinkButton {href} {variant} icon={icon?.name} class:list={[className]} {...attrs}>
								{text}
								{icon?.html && <Fragment set:html={icon.html} />}
							</LinkButton>
						))}
					</div>
				)}
			</div>
			<div class="drawing">
				<TrustTriangle {...trust} bare />
			</div>
		</div>
	) : (
		<Default />
	)
}

<style>
	.hero {
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		align-items: center;
		gap: 2rem;
		padding-bottom: 1rem;
	}
	.stack {
		display: flex;
		flex-direction: column;
		gap: clamp(1.5rem, calc(1.5rem + 1vw), 2rem);
		text-align: center;
	}
	.copy {
		display: flex;
		flex-direction: column;
		gap: 1rem;
		align-items: center;
	}
	.copy > * {
		max-width: 50ch;
	}
	h1 {
		font-size: clamp(var(--sl-text-3xl), calc(0.25rem + 5vw), var(--sl-text-6xl));
		line-height: var(--sl-line-height-headings);
		font-weight: 600;
		color: var(--sl-color-white);
	}
	.tagline {
		font-size: clamp(var(--sl-text-base), calc(0.0625rem + 2vw), var(--sl-text-xl));
		color: var(--sl-color-gray-2);
	}
	.actions {
		display: flex;
		flex-wrap: wrap;
		gap: 1rem 2rem;
		justify-content: center;
	}
	.drawing {
		min-width: 0;
	}
	@media (min-width: 50rem) {
		.hero {
			grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr);
			gap: 4%;
			padding-block: clamp(2.5rem, calc(1rem + 8vmin), 7rem);
		}
		.stack {
			text-align: start;
		}
		.copy {
			align-items: flex-start;
		}
		.actions {
			justify-content: flex-start;
		}
	}
</style>
