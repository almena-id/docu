---
// Ways in, as large cards: who each is for, what it covers and where it goes.
import Icon, { type IconName } from './Icon.astro';

interface Path {
	icon: IconName;
	title: string;
	/** Who it is for, in a few words. */
	who: string;
	text: string;
	href: string;
}
interface Props {
	paths: Path[];
}
const { paths } = Astro.props;
---

<ul class="paths not-content">
	{
		paths.map(({ icon, title, who, text, href }) => (
			<li>
				<a href={href}>
					<span class="icon">
						<Icon name={icon} size={28} />
					</span>
					<span class="who">{who}</span>
					<strong>{title}</strong>
					<span class="text">{text}</span>
					<span class="go" aria-hidden="true">
						→
					</span>
				</a>
			</li>
		))
	}
</ul>

<style>
	.paths {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
		gap: 1rem;
		margin-block: 1.5rem;
		padding: 0;
		list-style: none;
	}
	a {
		display: grid;
		align-content: start;
		gap: 0.4rem;
		height: 100%;
		padding: 1.4rem 1.4rem 1.1rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 1rem;
		background: var(--sl-color-gray-7, var(--sl-color-black));
		color: inherit;
		text-decoration: none;
		transition:
			border-color 0.15s,
			translate 0.15s;
	}
	a:hover,
	a:focus-visible {
		border-color: var(--sl-color-accent);
		translate: 0 -2px;
	}
	.icon {
		display: grid;
		place-items: center;
		width: 3.1rem;
		height: 3.1rem;
		margin-bottom: 0.4rem;
		border-radius: 0.8rem;
		background: var(--sl-color-accent-low);
		color: var(--sl-color-text-accent);
	}
	.who {
		color: var(--sl-color-gray-3);
		font-size: var(--sl-text-xs);
		font-weight: 600;
		letter-spacing: 0.06em;
		text-transform: uppercase;
	}
	strong {
		color: var(--sl-color-white);
		font-family: var(--font-brand, sans-serif);
		font-size: var(--sl-text-xl);
		line-height: 1.2;
	}
	.text {
		color: var(--sl-color-gray-2);
		font-size: var(--sl-text-sm);
		line-height: 1.5;
	}
	.go {
		margin-top: 0.4rem;
		color: var(--sl-color-text-accent);
		font-size: 1.2rem;
	}
</style>
