---
// A screen of a portal as the reader sees it: the picture in the page's
// language and theme (light or dark, following the site's), with its numbered
// marks over it — the same numbers the text names with <Mark n={…} />.
// Pictures and marks come from `task screenshots` (scripts/screenshots.mjs):
// src/assets/screenshots/{lang}/{theme}/{name}.webp, src/data/screenshots.json.
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import marks from '../../data/screenshots.json';

interface Props {
	name: keyof typeof marks;
	/** What the picture shows, for whoever cannot see it. */
	alt: string;
	/** Leave the numbers out. */
	plain?: boolean;
	/** A phone's screen (the wallet): narrow and centred, or side by side in <Screens>. */
	phone?: boolean;
	/** The first mark's number, when screens side by side share the text's numbers. */
	from?: number;
}

const { name, alt, plain = false, phone = false, from = 1 } = Astro.props;
const lang = Astro.locals.starlightRoute.lang === 'es' ? 'es' : 'en';
const pictures = import.meta.glob<{ default: ImageMetadata }>(
	'../../assets/screenshots/*/*/*.webp',
	{ eager: true },
);
const picture = (theme: 'light' | 'dark') => {
	const found = pictures[`../../assets/screenshots/${lang}/${theme}/${name}.webp`];
	if (!found) throw new Error(`No screenshot ${lang}/${theme}/${name}: run task screenshots`);
	return found.default;
};
const placed = plain ? [] : (marks[name] as Record<string, { x: number; y: number }[]>)[lang];
---

<figure class:list={['screenshot not-content', { phone }]}>
	<div class="frame">
		{
			// Each opens at full size: on a phone the screen is small.
			(['light', 'dark'] as const).map((theme) => (
				<a class={`shot shot-${theme}`} href={picture(theme).src} target="_blank">
					<Image
						src={picture(theme)}
						alt={alt}
						widths={phone ? [390, 780] : [640, 960, 1280, 1920]}
						sizes={phone ? '(min-width: 50rem) 20rem, 90vw' : '(min-width: 72rem) 56rem, 100vw'}
					/>
				</a>
			))
		}
		{
			placed.map(({ x, y }, index) => (
				<span class="mark" style={`left: ${x}%; top: ${y}%`} aria-hidden="true">
					{index + from}
				</span>
			))
		}
	</div>
	{
		Astro.slots.has('default') && (
			<figcaption>
				<slot />
			</figcaption>
		)
	}
</figure>

<style>
	.screenshot {
		margin-block: 1.5rem;
	}
	.screenshot.phone {
		width: min(100%, 20rem);
		margin-inline: auto;
	}
	.phone .frame {
		border-radius: 1.6rem;
	}
	.frame {
		position: relative;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 0.75rem;
		overflow: hidden;
		box-shadow: var(--sl-shadow-md);
		background: var(--sl-color-gray-6);
	}
	.shot {
		display: block;
		cursor: zoom-in;
	}
	.shot :global(img) {
		display: block;
		width: 100%;
		height: auto;
	}
	.shot-dark {
		display: none;
	}
	:global(:root[data-theme='dark']) .shot-light {
		display: none;
	}
	:global(:root[data-theme='dark']) .shot-dark {
		display: block;
	}
	/* The mark's spot is its element's top left corner: it sits mostly out
	   of the element, up and to the left, so the words it points at show. */
	.mark {
		position: absolute;
		translate: -80% -80%;
		display: grid;
		place-items: center;
		width: clamp(1.25rem, 2.6vw, 1.75rem);
		aspect-ratio: 1;
		border-radius: 50%;
		background: var(--sl-color-accent);
		color: #1a1300;
		font: 700 clamp(0.7rem, 1.4vw, 0.9rem) / 1 var(--font-sans, sans-serif);
		box-shadow:
			0 0 0 3px rgb(255 255 255 / 0.9),
			0 2px 6px rgb(0 0 0 / 0.35);
	}
	figcaption {
		margin-top: 0.6rem;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-3);
		text-align: center;
	}
</style>
