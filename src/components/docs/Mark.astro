---
// A screenshot's numbered mark in the text: "press <Mark n={2} />".
interface Props {
	n: number;
}
const { n } = Astro.props;
---

<span class="mark">{n}</span>

<style>
	.mark {
		display: inline-grid;
		place-items: center;
		width: 1.45em;
		height: 1.45em;
		margin-inline: 0.1em;
		border-radius: 50%;
		background: var(--sl-color-accent);
		color: #1a1300;
		font-size: 0.8em;
		font-weight: 700;
		line-height: 1;
		vertical-align: 0.1em;
	}
</style>
