---
// The portals' header, as in catalog: the brand (src/components/SiteTitle.astro),
// in the page frame (src/styles/layout.css), then Starlight's search (Pagefind)
// at the far end — the documentation is long enough to need it. No social
// links; the theme and the language are chosen in the footer
// (src/components/SiteFooter.astro).
import Search from 'virtual:starlight/components/Search';
import SiteTitle from 'virtual:starlight/components/SiteTitle';
---

<div class="header">
	<SiteTitle />
	<div class="search">
		<Search />
	</div>
</div>

<style>
	.header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		height: 100%;
	}
	.header > :global(:first-child) {
		/* Keep a long title clear of the search and the mobile menu button. */
		min-width: 0;
		overflow: clip;
	}
	/* On a phone the search is a button: it takes no more than its icon. */
	.search {
		display: flex;
		flex: none;
		justify-content: flex-end;
	}
	@media (min-width: 50rem) {
		.search {
			flex: 0 1 22rem;
		}
		.search :global(site-search) {
			width: 100%;
		}
	}
</style>
