---
// The portals' header brand: the Almena mark and "Almena Docs", as in
// catalog and status.
import Logo from './Logo.astro';

const { siteTitle, siteTitleHref } = Astro.locals.starlightRoute;
---

<a href={siteTitleHref} class="site-title" aria-label={siteTitle}>
	<Logo size={28} />
	<span translate="no">Almena <strong>Docs</strong></span>
</a>

<style>
	.site-title {
		display: inline-flex;
		align-items: center;
		gap: 0.625rem;
		min-width: 0;
		font-family: var(--font-brand);
		font-size: 17px;
		font-weight: 400;
		letter-spacing: -0.025em;
		color: var(--sl-color-white);
		text-decoration: none;
		white-space: nowrap;
	}
	span {
		overflow: hidden;
	}
	strong {
		font-weight: 600;
	}
</style>
