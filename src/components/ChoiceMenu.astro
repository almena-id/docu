---
// catalog's footer menu (app/components/ChoiceMenu.tsx) for Starlight: a ghost
// trigger with an icon and the current choice, opening above it a titled,
// checked list. Choosing an entry with an href goes there; otherwise the
// element fires a `choice` event with the value, for ThemeMenu to apply.
import LucideIcon from './LucideIcon.astro';

type IconName = 'languages' | 'monitor' | 'sun' | 'moon';
export interface Choice {
	value: string;
	label: string;
	icon?: IconName;
	lang?: string;
	href?: string;
}
interface Props {
	label: string;
	icon: IconName;
	value: string;
	choices: Choice[];
	kind: string;
}
const { label, icon, value, choices, kind } = Astro.props;
const current = choices.find((choice) => choice.value === value);
---

<almena-choice-menu data-kind={kind}>
	<button type="button" class="trigger" aria-haspopup="menu" aria-expanded="false" aria-label={label}>
		<span class="trigger-icon"><LucideIcon name={current?.icon ?? icon} /></span>
		<span class="trigger-label">{current?.label}</span>
	</button>
	<div class="menu" role="menu" aria-label={label} hidden>
		<div class="menu-label">{label}</div>
		<div class="separator" role="separator"></div>
		{
			choices.map((choice) => (
				<button
					type="button"
					class="item"
					role="menuitemradio"
					aria-checked={choice.value === value ? 'true' : 'false'}
					tabindex="-1"
					data-value={choice.value}
					data-href={choice.href}
					lang={choice.lang}
				>
					<span class="indicator" aria-hidden="true" />
					{choice.icon && <LucideIcon name={choice.icon} class="item-icon" />}
					<span class="item-label">{choice.label}</span>
				</button>
			))
		}
	</div>
</almena-choice-menu>

<script>
	class AlmenaChoiceMenu extends HTMLElement {
		#trigger = this.querySelector<HTMLButtonElement>('.trigger')!;
		#menu = this.querySelector<HTMLElement>('.menu')!;
		#items = [...this.querySelectorAll<HTMLButtonElement>('.item')];

		connectedCallback() {
			this.#trigger.addEventListener('click', () => (this.#menu.hidden ? this.#open() : this.#close()));
			this.#trigger.addEventListener('keydown', (event) => {
				if (event.key === 'ArrowUp' || event.key === 'ArrowDown') {
					event.preventDefault();
					this.#open();
				}
			});
			this.#items.forEach((item) => item.addEventListener('click', () => this.#choose(item)));
			this.#menu.addEventListener('keydown', (event) => this.#onKey(event));
			document.addEventListener('pointerdown', (event) => {
				if (!this.#menu.hidden && !this.contains(event.target as Node)) this.#close(false);
			});
			this.addEventListener('focusout', (event) => {
				if (!this.contains(event.relatedTarget as Node | null)) this.#close(false);
			});
		}

		/** Marks a value as the current one: checked in the list, shown on the trigger. */
		setValue(value: string) {
			const chosen = this.#items.find((item) => item.dataset.value === value);
			if (!chosen) return;
			this.#items.forEach((item) => item.setAttribute('aria-checked', String(item === chosen)));
			this.#trigger.querySelector('.trigger-label')!.textContent =
				chosen.querySelector('.item-label')!.textContent;
			const icon = chosen.querySelector('.item-icon');
			if (icon) this.#trigger.querySelector('.trigger-icon')!.replaceChildren(icon.cloneNode(true));
		}

		#open() {
			this.#menu.hidden = false;
			this.#trigger.setAttribute('aria-expanded', 'true');
			const checked = this.#items.find((item) => item.getAttribute('aria-checked') === 'true');
			(checked ?? this.#items[0])?.focus();
		}

		#close(refocus = true) {
			if (this.#menu.hidden) return;
			this.#menu.hidden = true;
			this.#trigger.setAttribute('aria-expanded', 'false');
			if (refocus) this.#trigger.focus();
		}

		#choose(item: HTMLButtonElement) {
			const { value, href } = item.dataset;
			this.#close();
			if (href) {
				if (item.getAttribute('aria-checked') !== 'true') window.location.href = href;
				return;
			}
			this.setValue(value!);
			this.dispatchEvent(new CustomEvent('choice', { detail: value }));
		}

		#onKey(event: KeyboardEvent) {
			const index = this.#items.indexOf(document.activeElement as HTMLButtonElement);
			const move = (to: number) => {
				event.preventDefault();
				this.#items[(to + this.#items.length) % this.#items.length]?.focus();
			};
			if (event.key === 'ArrowDown') move(index + 1);
			else if (event.key === 'ArrowUp') move(index - 1);
			else if (event.key === 'Home') move(0);
			else if (event.key === 'End') move(this.#items.length - 1);
			else if (event.key === 'Escape') {
				event.preventDefault();
				this.#close();
			} else if (event.key === 'Tab') this.#close(false);
		}
	}
	customElements.define('almena-choice-menu', AlmenaChoiceMenu);
</script>

<style>
	almena-choice-menu {
		position: relative;
		display: inline-block;
	}

	/* catalog's ghost button, size sm. */
	.trigger {
		display: inline-flex;
		align-items: center;
		gap: 0.375rem;
		height: 2rem;
		padding-inline: 0.75rem;
		border: 0;
		border-radius: 10px;
		background: transparent;
		color: var(--sl-color-white);
		font: inherit;
		font-size: 0.875rem;
		font-weight: 500;
		white-space: nowrap;
		cursor: pointer;
	}
	.trigger:hover,
	.trigger[aria-expanded='true'] {
		background: var(--menu-accent);
	}
	.trigger:focus-visible,
	.item:focus-visible {
		outline: 2px solid var(--sl-color-accent);
		outline-offset: 1px;
	}
	.trigger-icon {
		display: inline-flex;
		color: var(--sl-color-gray-3);
	}

	/* catalog's dropdown content, opening above the trigger, aligned to its end. */
	.menu {
		position: absolute;
		inset-inline-end: 0;
		bottom: calc(100% + 4px);
		z-index: 1;
		width: 11rem;
		padding: 4px;
		border: 1px solid var(--sl-color-hairline-light);
		border-radius: 10px;
		background: var(--menu-bg);
		color: var(--sl-color-white);
		box-shadow: var(--menu-shadow);
	}
	.menu[hidden] {
		display: none;
	}
	.menu-label {
		padding: 0.375rem 0.5rem;
		font-size: 0.75rem;
		font-weight: 500;
		color: var(--sl-color-gray-3);
	}
	.separator {
		height: 1px;
		margin: 4px -4px;
		background: var(--sl-color-hairline-light);
	}
	.item {
		position: relative;
		display: flex;
		align-items: center;
		gap: 0.5rem;
		width: 100%;
		padding: 0.375rem 0.5rem 0.375rem 2rem;
		border: 0;
		border-radius: 8px;
		background: transparent;
		color: inherit;
		font: inherit;
		font-size: 0.875rem;
		text-align: start;
		cursor: default;
	}
	.item:hover,
	.item:focus {
		background: var(--menu-accent);
		outline: none;
	}
	.item :global(svg) {
		flex: none;
	}
	/* The radio dot of the current choice. */
	.indicator {
		position: absolute;
		inset-inline-start: 0.5rem;
		top: 50%;
		width: 14px;
		height: 14px;
		translate: 0 -50%;
		display: flex;
		align-items: center;
		justify-content: center;
	}
	.item[aria-checked='true'] .indicator::after {
		content: '';
		width: 8px;
		height: 8px;
		border-radius: 50%;
		background: currentColor;
	}

	almena-choice-menu {
		--menu-bg: #1f2127;
		--menu-accent: rgba(255, 255, 255, 0.06);
		--menu-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.3), 0 2px 4px -2px rgba(0, 0, 0, 0.3);
	}
	:global(:root[data-theme='light']) almena-choice-menu {
		--menu-bg: #ffffff;
		--menu-accent: rgba(23, 24, 28, 0.05);
		--menu-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -2px rgba(0, 0, 0, 0.1);
	}
</style>
